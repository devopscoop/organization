# Brewfile for organization
#
# Installs every CLI tool used or referenced by this repo.
# Usage: brew bundle

# git - the bootstrap.md multi-remote workflow (Codeberg/GitLab/GitHub)
brew "git"

# gh - claude_github_actions.md distributes the CLAUDE_CODE_OAUTH_TOKEN secret
brew "gh"

# claude - claude_github_actions.md creates the token with `claude setup-token`
cask "claude-code"
